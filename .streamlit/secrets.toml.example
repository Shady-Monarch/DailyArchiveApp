# Copy this file to secrets.toml and fill in your values.
# Never commit secrets.toml.

# From the Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
spreadsheet_id = "YOUR_SPREADSHEET_ID"

# Or use the full URL instead of spreadsheet_id:
# spreadsheet_url = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit"

[google_oauth]
client_id = "YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_OAUTH_CLIENT_SECRET"
# Local default used by the app if omitted:
redirect_uri = "http://localhost:8501"
# For Streamlit Cloud, set this to your app URL, e.g.:
# redirect_uri = "https://your-app-name.streamlit.app"

# Optional (Cloud convenience): after first local login, copy refresh_token
# from .streamlit/google_token.json into secrets so Cloud can reuse it.
# refresh_token = "YOUR_REFRESH_TOKEN"
